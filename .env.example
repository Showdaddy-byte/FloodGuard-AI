# Copy to .env for local development. NEVER put real keys in this file:
# .env.example is committed to git. Real values live in .env (gitignored)
# locally and in Render's Environment tab in production.

OPENWEATHER_API_KEY=your_openweather_api_key_here
TIDE_API_KEY=your_worldtides_key_here
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
WEATHERAPI_KEY=your_weatherapi_key_here
GEOAPIFY_API_KEY=your_geoapify_key_here

EARTH_ENGINE_ENABLED=1
GEE_PRIVATE_KEY_PATH=credentials/your-service-account-key.json
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_PROJECT=your-google-cloud-project-id

BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=FloodGuard AI
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_long_random_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generate_with_werkzeug_generate_password_hash
CRON_SECRET=generate_a_long_random_string
SITE_BASE_URL=https://myfloodguard.online

# ---- Street-level risk (new) ----
# Alert level on FloodGuard's 0-100 score. This is NOT a probability.
FLOOD_ALERT_THRESHOLD=30
# Optional per-country overrides, e.g. GB=35,BD=25
FLOOD_ALERT_THRESHOLD_BY_COUNTRY=
STREET_CACHE_MINUTES=180
STREET_SWEEP_MAX_PER_RUN=6

# ---- Telegram alerts (new) ----
# Create the bot with @BotFather. Keep the token secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=generate_a_long_random_string
TELEGRAM_BOT_USERNAME=
# test = nothing is sent to subscribers (admins only). Switch to live when ready.
TELEGRAM_MODE=test
# Comma-separated numeric chat ids that may receive test alerts
TELEGRAM_ADMIN_CHAT_IDS=
# Optional tuning (defaults shown)
TELEGRAM_COOLDOWN_HOURS=6
TELEGRAM_ESCALATION_DELTA=15
TELEGRAM_URGENT_MIN_GAP_MINUTES=30
TELEGRAM_MAX_DATA_AGE_MINUTES=90
TELEGRAM_CLEAR_MARGIN=5
TELEGRAM_MAX_LOCATIONS=5
